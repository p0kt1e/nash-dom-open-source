{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nash-dom-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nash-dom-db",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
